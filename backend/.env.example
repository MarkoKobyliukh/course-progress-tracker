# Copy to .env and adjust if needed.

# HOST machine (Prisma CLI, `npm run dev` outside Docker).
# Postgres is exposed on host port 5433 (local PG17 owns 5432).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/courses_db"

# Inside Docker Compose the backend uses instead:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/courses_db"

PORT=4000
